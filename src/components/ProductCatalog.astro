---
// src/components/ProductCatalog.astro
//
// Grid de produse filtrabil pe categorie, pentru UN singur brand.
// Stil vizual aliniat cu restul site-ului (vintage industrial Americana):
// colțuri drepte, borduri groase, eyebrow uppercase, hover cu umbră offset.
//
// Props:
//   brand        — "milan" | "brrr"
//   accentColor  — culoare accent (hex) pentru chips active / badge NOU
//   accentText   — culoare text pe fundal accent

import productsData from '../data/products.json';

interface Props {
  brand: string;
  accentColor: string;
  accentText: string;
  chipColor?: string;
}

const { brand, accentColor, accentText, chipColor } = Astro.props;

const allProducts = productsData.products.filter((p: any) => p.brand === brand);

const categoryEntries = Object.entries(productsData.categories as Record<string, any>)
  .filter(([key]) => allProducts.some((p: any) => p.category === key))
  .sort((a, b) => a[1].order - b[1].order);
---

<div class="catalog-wrap bg-cream" style={`--accent: ${accentColor}; --accent-text: ${accentText}; --chip-border: ${chipColor || 'var(--color-ink, #1A1816)'};`}>
  <div class="mx-auto max-w-7xl px-5 lg:px-10 py-12 lg:py-16">

    <div class="chips" role="tablist" aria-label="Filtrare pe categorie">
      <button class="chip is-active" data-filter="all" type="button">Toate</button>
      {categoryEntries.map(([key, cat]) => (
        <button class="chip" data-filter={key} type="button">
          <span class="chip__icon">{cat.icon}</span>{cat.label}
        </button>
      ))}
    </div>

    <div class="grid">
      {allProducts.map((p: any) => (
        <article class="card stamp-card" data-category={p.category}>
          <div class="card__image-wrap">
            <img src={p.image} alt={p.name} loading="lazy" />
            {p.tags?.includes('de post') && <span class="badge badge--post">De post</span>}
            {p.tags?.includes('nou') && <span class="badge badge--nou">Nou</span>}
          </div>
          <div class="card__body">
            <h3 class="card__name">{p.name}</h3>
            <p class="card__meta numeric">{p.weight} · {p.pack}</p>
          </div>
        </article>
      ))}
    </div>

    <p class="empty-state" hidden>Niciun produs în această categorie.</p>
  </div>
</div>

<script>
  document.querySelectorAll<HTMLElement>('.catalog-wrap').forEach((catalogEl) => {
    const chips = catalogEl.querySelectorAll<HTMLButtonElement>('.chip');
    const cards = catalogEl.querySelectorAll<HTMLElement>('.card');
    const emptyState = catalogEl.querySelector<HTMLElement>('.empty-state');

    chips.forEach((chip) => {
      chip.addEventListener('click', () => {
        chips.forEach((c) => c.classList.remove('is-active'));
        chip.classList.add('is-active');

        const filter = chip.dataset.filter;
        let visibleCount = 0;

        cards.forEach((card) => {
          const show = filter === 'all' || card.dataset.category === filter;
          (card as HTMLElement).style.display = show ? '' : 'none';
          if (show) visibleCount++;
        });

        if (emptyState) {
          emptyState.hidden = visibleCount !== 0;
        }
      });
    });
  });
</script>

<style>
  .catalog-wrap {
    --accent: #E81820;
    --accent-text: #F5EFE3;
  }

  /* ── Filter chips ── */
  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    margin-bottom: 2.5rem;
  }

  .chip {
    font-family: var(--font-display);
    font-size: 0.7rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    border: 2px solid var(--chip-border, var(--color-ink, #1A1816));
    background: var(--color-paper, #FAF6EE);
    color: var(--chip-border, var(--color-ink, #1A1816));
    padding: 0.6rem 1.1rem;
    cursor: pointer;
    transition: all 0.15s ease;
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
  }

  .chip:hover {
    border-color: var(--accent);
    color: var(--accent);
  }

  .chip.is-active {
    background: var(--accent);
    color: var(--accent-text);
    border-color: var(--accent);
  }

  .chip__icon {
    font-size: 1rem;
    line-height: 1;
  }

  /* ── Product grid ── */
  .grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1.5rem;
  }

  @media (min-width: 640px) {
    .grid { grid-template-columns: repeat(3, 1fr); }
  }

  @media (min-width: 980px) {
    .grid { grid-template-columns: repeat(4, 1fr); }
  }

  .card {
    background: var(--color-paper, #FAF6EE);
    border: 2px solid rgba(26, 24, 22, 0.12);
  }

  .card__image-wrap {
    position: relative;
    aspect-ratio: 1 / 1;
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--color-cream-dark, #E8DFCB);
    padding: 1rem;
  }

  .card__image-wrap img {
    max-width: 100%;
    max-height: 100%;
    object-fit: contain;
  }

  .badge {
    position: absolute;
    top: 0.5rem;
    padding: 0.2rem 0.6rem;
    font-family: var(--font-display);
    font-size: 0.65rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    border: 1px solid rgba(0, 0, 0, 0.1);
  }

  .badge--post {
    left: 0.5rem;
    background: var(--color-navy, #182060);
    color: var(--color-cream, #F5EFE3);
  }

  .badge--nou {
    right: 0.5rem;
    background: var(--accent);
    color: var(--accent-text);
  }

  .card__body {
    padding: 0.9rem 1rem 1.1rem;
    border-top: 2px solid rgba(26, 24, 22, 0.12);
  }

  .card__name {
    font-family: var(--font-sans);
    font-weight: 600;
    font-size: 0.95rem;
    margin: 0 0 0.3rem;
    line-height: 1.25;
    color: var(--color-ink, #1A1816);
  }

  .card__meta {
    font-size: 0.75rem;
    color: rgba(26, 24, 22, 0.5);
    margin: 0;
  }

  .empty-state {
    text-align: center;
    color: rgba(26, 24, 22, 0.5);
    padding: 4rem 0;
    font-family: var(--font-display);
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }
</style>
