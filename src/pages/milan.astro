---
// src/pages/milan.astro
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ProductCatalog from '../components/ProductCatalog.astro';
---

<Layout title="Gama Milan — Cuneco">
  <Header />

  <section class="relative bg-navy text-cream py-16 lg:py-24 overflow-hidden grain text-center">
    <div class="relative mx-auto max-w-7xl px-5 lg:px-10">
      <a href="/catalog" class="eyebrow text-cream/60 hover:text-brick-light transition-colors inline-block mb-6">
        &larr; Toate brandurile
      </a>
      <h1 class="display-tight text-brick-light text-[clamp(2.5rem,7vw,5rem)]">
        Milan
      </h1>
      <p class="mt-4 text-cream/70 text-base lg:text-lg max-w-md mx-auto">
        Croissant, rulade, napolitane, biscuiți și sucuri — distribuție națională.
      </p>
    </div>
  </section>

  <ProductCatalog brand="milan" accentColor="#E81820" accentText="#F5EFE3" chipColor="#182060" />

  <Footer />
</Layout>
