---
// src/pages/catalog.astro
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<Layout title="Catalog — Cuneco">
  <Header />

  <section class="relative bg-cream text-ink py-20 lg:py-32 overflow-hidden grain">
    <div class="relative mx-auto max-w-7xl px-5 lg:px-10">
      <div class="text-center mb-14 lg:mb-20 reveal-up">
        <div class="flex items-center justify-center gap-3 mb-4 lg:mb-6">
          <span class="inline-block w-10 h-px bg-brick"></span>
          <span class="eyebrow text-ink/50">Catalog</span>
          <span class="inline-block w-10 h-px bg-brick"></span>
        </div>
        <h1 class="display-tight text-ink text-[clamp(2.5rem,8vw,6rem)]">
          Alege <span class="italic-serif text-brick" style="text-transform: none;">gama.</span>
        </h1>
        <p class="mt-4 text-ink/60 text-base lg:text-lg max-w-md mx-auto">
          Distribuim două branduri distincte. Alege ce te interesează.
        </p>
      </div>

      <div class="grid lg:grid-cols-2 gap-6 lg:gap-8 max-w-5xl mx-auto">
        <a href="/milan" class="stamp-card group block bg-navy border-4 border-navy relative overflow-hidden">
          <div class="relative h-64 lg:h-80 overflow-hidden bg-cream-dark flex items-center justify-center p-8">
            <img
              src="/img/products/milan-suc-portocale-200ml.webp"
              alt="Milan"
              class="max-w-full max-h-full w-auto h-auto object-contain group-hover:scale-105 transition-transform duration-500"
            />
          </div>
          <div class="p-7 lg:p-9 text-cream">
            <span class="eyebrow text-cream/60">Dulciuri</span>
            <h2 class="display-tight text-cream text-4xl lg:text-5xl mt-2 mb-3">Milan</h2>
            <p class="text-cream/70 text-sm lg:text-base">
              Croissant, rulade, napolitane, biscuiți, sucuri
            </p>
          </div>
        </a>

        <a href="/brrr" class="stamp-card group block bg-ink border-4 border-ink relative overflow-hidden">
          <div class="relative h-64 lg:h-80 overflow-hidden bg-cream-dark flex items-center justify-center p-8">
            <img
              src="/img/products/brrr-chips-chicken-stick-30g.jpg"
              alt="BRRR"
              class="max-w-full max-h-full w-auto h-auto object-contain group-hover:scale-105 transition-transform duration-500"
            />
          </div>
          <div class="p-7 lg:p-9 text-cream">
            <span class="eyebrow" style="color:#F2B705;">Snacks</span>
            <h2 class="display-tight mt-2 mb-3 text-4xl lg:text-5xl" style="color:#F2B705;">BRRR</h2>
            <p class="text-cream/70 text-sm lg:text-base">
              Chips, flips, popcorn, wafer rolls
            </p>
          </div>
        </a>
      </div>
    </div>
  </section>

  <Footer />
</Layout>
