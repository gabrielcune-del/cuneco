---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Catalog — Cuneco">
  <section class="brand-select">
    <h1>Alege gama</h1>
    <p class="subtitle">Distribuim două branduri distincte. Alege ce te interesează.</p>

    <div class="brand-grid">
      <a href="/milan" class="brand-card brand-card--milan">
        <span class="brand-card__eyebrow">Dulciuri</span>
        <span class="brand-card__name">MILAN</span>
        <span class="brand-card__desc">Croissant, rulade, napolitane, biscuiți, sucuri</span>
      </a>

      <a href="/brrr" class="brand-card brand-card--brrr">
        <span class="brand-card__eyebrow">Snacks sărate</span>
        <span class="brand-card__name">BRRR</span>
        <span class="brand-card__desc">Chips, flips, popcorn, wafer rolls</span>
      </a>
    </div>
  </section>
</Layout>

<style>
  .brand-select {
    max-width: 1100px;
    margin: 0 auto;
    padding: 3rem 1.5rem 5rem;
    text-align: center;
  }

  .brand-select h1 {
    font-size: clamp(2rem, 4vw, 2.75rem);
    margin-bottom: 0.5rem;
  }

  .subtitle {
    color: #6b6b6b;
    margin-bottom: 2.5rem;
  }

  .brand-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.5rem;
  }

  @media (min-width: 720px) {
    .brand-grid {
      grid-template-columns: 1fr 1fr;
    }
  }

  .brand-card {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    justify-content: flex-end;
    min-height: 320px;
    padding: 2rem;
    border-radius: 20px;
    text-decoration: none;
    position: relative;
    overflow: hidden;
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }

  .brand-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 16px 40px rgba(0, 0, 0, 0.18);
  }

  .brand-card__eyebrow {
    font-size: 0.8rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    opacity: 0.85;
    margin-bottom: 0.5rem;
  }

  .brand-card__name {
    font-size: 2.75rem;
    font-weight: 800;
    line-height: 1;
    margin-bottom: 0.6rem;
    font-style: italic;
  }

  .brand-card__desc {
    font-size: 0.95rem;
    opacity: 0.9;
  }

  .brand-card--milan {
    background: linear-gradient(135deg, #b3231f 0%, #7a1613 100%);
    color: #fdf6ee;
  }

  .brand-card--brrr {
    background: linear-gradient(135deg, #ffd400 0%, #ff8a00 100%);
    color: #1a1a1a;
  }
</style>
