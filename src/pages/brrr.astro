---
// src/pages/brrr.astro
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ProductCatalog from '../components/ProductCatalog.astro';
---

<Layout title="Gama BRRR — Cuneco">
  <Header />

  <section class="relative bg-ink text-cream py-16 lg:py-24 overflow-hidden grain text-center">
    <div class="relative mx-auto max-w-7xl px-5 lg:px-10">
      <a href="/catalog" class="eyebrow text-cream/60 hover:text-brick-light transition-colors inline-block mb-6">
        &larr; Toate brandurile
      </a>
      <h1 class="display-tight text-[clamp(2.5rem,7vw,5rem)]" style="color:#F2B705;">
        <span class="italic-serif" style="text-transform:none;">BRRR</span>
      </h1>
      <p class="mt-4 text-cream/70 text-base lg:text-lg max-w-md mx-auto">
        Chips, flips, popcorn și wafer rolls — snacks cu energie.
      </p>
    </div>
  </section>

  <ProductCatalog brand="brrr" accentColor="#F2B705" accentText="#1A1816" />

  <Footer />
</Layout>
