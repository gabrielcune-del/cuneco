---
// src/pages/catalog/brrr.astro
import Layout from '../../layouts/Layout.astro';
import ProductCatalog from '../../components/ProductCatalog.astro';
---

<Layout title="Gama BRRR — Cuneco">
  <section class="hero hero--brrr">
    <a href="/catalog" class="back-link">&larr; Toate brandurile</a>
    <h1>BRRR</h1>
    <p>Chips, flips, popcorn și wafer rolls — snacks sărate cu energie.</p>
  </section>

  <ProductCatalog brand="brrr" accentColor="#ffd400" accentText="#1a1a1a" />
</Layout>

<style>
  .hero {
    padding: 2.5rem 1.5rem 2rem;
    text-align: center;
    color: #1a1a1a;
    background: linear-gradient(135deg, #ffd400 0%, #ff8a00 100%);
    margin-bottom: 2rem;
  }

  .hero h1 {
    font-size: clamp(2rem, 5vw, 3rem);
    font-style: italic;
    font-weight: 800;
    margin: 0.5rem 0;
  }

  .hero p {
    opacity: 0.85;
    max-width: 480px;
    margin: 0 auto;
  }

  .back-link {
    display: inline-block;
    color: inherit;
    opacity: 0.75;
    text-decoration: none;
    font-size: 0.9rem;
  }

  .back-link:hover {
    opacity: 1;
    text-decoration: underline;
  }
</style>
